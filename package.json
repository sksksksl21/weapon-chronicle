{
  "name": "weapon-chronicle",
  "version": "5.2.0-codex-baseline",
  "private": true,
  "description": "Weapon Chronicle — Codex managed Odyssey life simulator",
  "scripts": {
    "build": "python3 tools/build.py",
    "check": "python3 tools/verify_baseline.py",
    "dev": "python3 tools/build.py && python3 -m http.server 5173 --bind 0.0.0.0",
    "test:smoke": "python3 tests/ui_smoke.py",
    "test:regression": "python3 tests/regression.py && python3 tests/action_policy.py && python3 tests/combat_resource_transfer.py && python3 tests/owner_combat_personality.py && python3 tests/reward_pool.py && python3 tests/card_engraving.py && python3 tests/save_compat_additive.py",
    "test:story": "bash scripts/test-story.sh",
    "test:combat-math": "node tests/combat_math_v1.js",
    "test:combat-adapter": "node tests/legacy_combat_sources_v1.js",
    "test:combat-handoff": "node tests/live_combat_handoff_v1.js",
    "test:live-combat": "node tests/live_combat_direct_v2.js",
    "test:status": "node tests/status_skilldeck_v1.js",
    "test:gear-rarity": "node tests/equipment_pool_v1.js",
    "test:merchant": "node tests/merchant_stock_v1.js",
    "test:direct-combat": "node tests/direct_combat_stats_v2.js"
  },
  "engines": {
    "node": ">=22"
  }
}
